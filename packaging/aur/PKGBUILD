# Maintainer: modest coder <me@modestcoder.eu>
pkgname=deepvibe-bin
pkgver=1.0.6
pkgrel=1
pkgdesc='The (unofficial) DeepSeek coding partner IDE'
arch=('x86_64')
url='https://deepvibe.eu'
license=('Apache-2.0')
depends=('gtk3' 'nss' 'libxss' 'libxtst' 'at-spi2-core' 'libnotify' 'xdg-utils' 'libsecret')
provides=('deepvibe')
conflicts=('deepvibe')
options=('!strip')
source=("${pkgname}-${pkgver}.AppImage::https://github.com/deepvibe-eu/DeepVibe/releases/download/v${pkgver}/DeepVibe-${pkgver}-linux-x86_64.AppImage"
        'deepvibe.desktop'
        'deepvibe.png')
sha256sums=('6fe1153076ee3e252aa425b207a7b08f8dc85487ef22ec07acbf559fd31e6bda'
            'SKIP'
            'SKIP')

package() {
  # Install the AppImage under /usr/lib (a valid ELF path) rather than /opt,
  # so it passes namcap's "ELF files outside of a valid path" check.
  install -d "$pkgdir/usr/lib/$pkgname"
  install -Dm755 "$srcdir/${pkgname}-${pkgver}.AppImage" "$pkgdir/usr/lib/$pkgname/deepvibe.AppImage"
  install -Dm644 "$srcdir/deepvibe.desktop" "$pkgdir/usr/share/applications/deepvibe.desktop"
  install -Dm644 "$srcdir/deepvibe.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/deepvibe.png"
  install -d "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/deepvibe.AppImage" "$pkgdir/usr/bin/deepvibe"
}
